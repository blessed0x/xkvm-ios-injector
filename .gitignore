# Build output
/bin/

# Reference clone of the upstream python tool (kept for porting reference)
/upstream/

# Local artifacts. Root-anchored so committed fixtures under testdata/
# (fixture IPAs, debs, Mach-Os, .cyan files) are NOT ignored.
/*.ipa
/*.tipa
/*.deb
/*.app

# Stray binary from a local `go build -o xkvm` — never commit build output.
/xkvm

# Session scratch dirs — never commit.
/.omc/
/.verifydriver/

# goreleaser output (local snapshot runs; release builds happen in CI).
/dist/

# macOS
.DS_Store
